# ── Site Config ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://your-domain.com
NEXT_PUBLIC_SITE_NAME_AR=اسم الموقع بالعربي
NEXT_PUBLIC_SITE_NAME_EN=Site Name in English
NEXT_PUBLIC_DEFAULT_LOCALE=ar

# ── Sanity CMS ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=                  # Read-only token (from Sanity → API → Tokens)
SANITY_WRITE_TOKEN=                # Write token — ONLY used by bulk import scripts. Keep secret.
SANITY_WEBHOOK_SECRET=             # Any random string. Must match what you set in Sanity webhook config.

# ── Analytics & Verification ───────────────────────────────────────────────────
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX            # Google Analytics 4 Measurement ID
NEXT_PUBLIC_GSC_VERIFICATION=xxxxx        # Google Search Console HTML tag value
NEXT_PUBLIC_BING_VERIFICATION=xxxxx       # Bing Webmaster Tools msvalidate.01 value
NEXT_PUBLIC_CLARITY_ID=xxxxx             # Microsoft Clarity project ID (optional, free heatmaps)

# ── Affiliate Tags ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_AMAZON_SA_TAG=yourname-21     # Amazon.sa affiliate tracking tag
NEXT_PUBLIC_AMAZON_COM_TAG=yourname-20   # Amazon.com affiliate tracking tag (for English articles)

# ── Cloudinary (for niche sites with quality images) ──────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Vercel (auto-set by Vercel on deploy, do not set manually) ────────────────
# VERCEL_URL=
