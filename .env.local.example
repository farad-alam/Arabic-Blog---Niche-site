# ═══════════════════════════════════════════════════════════════════════════════
# ENVIRONMENT VARIABLES TEMPLATE
# ───────────────────────────────────────────────────────────────────────────────
# 1. Copy this file to a new file named:  .env.local
# 2. Fill in your real values in .env.local
# 3. NEVER commit .env.local to Git — it is listed in .gitignore
# 4. For Cloudflare Pages: paste these values in Dashboard → Settings → Variables
# ═══════════════════════════════════════════════════════════════════════════════


# ── Site URL & Locale ──────────────────────────────────────────────────────────
# Stays in .env (not Sanity) because it's deployment-specific:
#   Local dev:  http://localhost:3000
#   Cloudflare: https://your-project.pages.dev  (until you have a real domain)
#   Production: https://your-real-domain.com
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# The default language shown to visitors (ar = Arabic, en = English)
NEXT_PUBLIC_DEFAULT_LOCALE=ar


# ── Sanity CMS ─────────────────────────────────────────────────────────────────
# Find these in: sanity.io/manage → your project → API
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id
NEXT_PUBLIC_SANITY_DATASET=production

# API Tokens (sanity.io/manage → your project → API → Tokens → Add API Token)
SANITY_API_TOKEN=                  # Read-only token — used to fetch content at build time
SANITY_WRITE_TOKEN=                # Write token — ONLY for bulk-import scripts. KEEP SECRET.

# Webhook secret — any random hard-to-guess string you make up.
# Example: blog-revalidate-secret-2026-xyzABC
# IMPORTANT: paste this EXACT same string in:
#   Sanity Dashboard → API → Webhooks → your webhook → Secret field
SANITY_WEBHOOK_SECRET=


# ── Amazon Affiliate Tags ──────────────────────────────────────────────────────
# Stays in .env (not Sanity) because:
#   - It's a business credential, not content
#   - Each niche site clone needs its own tag — just change .env, no code changes
#   - It never changes during normal content editing
#
# How to find your tags:
#   1. Go to: affiliate-program.amazon.com (for .com) or affiliate.amazon.sa (for .sa)
#   2. Log in → click your account name (top right) → "Account Settings"
#   3. Under "Your Account" → "Store ID & Tracking IDs" — your tag is listed there
#   4. Format: yourstore-21 (for .sa) or yourstore-20 (for .com)
#
# Arabic articles → amazon.sa → use AMAZON_SA_TAG
# English articles → amazon.com → use AMAZON_COM_TAG
NEXT_PUBLIC_AMAZON_SA_TAG=yourstore-21
NEXT_PUBLIC_AMAZON_COM_TAG=yourstore-20


# ── Analytics & Webmaster Verification ────────────────────────────────────────
# NOTE: GA4, GSC, Bing, and Clarity IDs are now managed from Sanity Studio.
#       Go to: Studio → Site Settings → 📊 Analytics & Tools
#       You do NOT need to set them here.
#
# These variables are kept here only as documentation reminders.
# (They are no longer read by the application code.)
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_GSC_VERIFICATION=xxxxx
# NEXT_PUBLIC_BING_VERIFICATION=xxxxx
# NEXT_PUBLIC_CLARITY_ID=xxxxx


# ── Cloudinary (optional — for image hosting on niche sites) ──────────────────
# Only needed if you use Cloudinary for article images.
# Find in: cloudinary.com → Dashboard → Product Environment Credentials
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
